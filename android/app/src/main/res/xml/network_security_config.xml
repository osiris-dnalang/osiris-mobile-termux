<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is refused everywhere except the on-device loopback daemons
  (NodeAlphaSubstrateBridge on :8000, osiris-ime-bridge on :8420). Requests to those are
  authenticated at the application layer (bearer token / HMAC request signature), not by
  transport. Anything that leaves the device must use TLS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
